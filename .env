# PrestaShop version to install into DDEV.
# You can use any published version (for example 8.2.3, 9.1.5, 9.2.0).
# PrestaShop 9 no longer ships a release asset, so the setup hook resolves the
# matching "edition" archive automatically. Pin it yourself with PS_ZIP_SOURCE.
PS_VERSION=8.2.3
PHP_VERSION=8.1

# Which PrestaShop build to install:
#   default -> official PrestaShop releases
#   vanilla -> VanillaPrestaShop builds from github.com/matrixino/VanillaPrestaShop
# VanillaPrestaShop only publishes a subset of versions, so PS_VERSION has to
# match one of its releases.
PRESTASHOP_FLAVOR=default

# PS_ZIP_SOURCE=

# The store is published by DDEV on a *.ddev.site hostname.
# hmr.json is generated from this project by .ddev/scripts/sync-hmr.sh.
BASE_URL=https://ps-vite-typescript.ddev.site

# PrestaShop setup configuration data
PS_DB_PREFIX=ps_
PS_FOLDER_ADMIN=admin-dev
PS_ADMIN_EMAIL=admin@prestashop.com
PS_ADMIN_PASSWORD=prestashop
PS_LANGUAGE=en
PS_COUNTRY=US

PLUGIN_VERSION=1.0.1
